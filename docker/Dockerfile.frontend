# Frontend-only Dockerfile for Komga (Dev Mode)
#
# Runs Vue.js dev server with hot-reload
# Connects to backend via VUE_APP_KOMGA_API_URL

FROM node:18-alpine
WORKDIR /app
COPY komga-webui/package.json komga-webui/package-lock.json ./
RUN npm ci
COPY komga-webui/ ./
EXPOSE 8081
CMD ["npm", "run", "serve"]
