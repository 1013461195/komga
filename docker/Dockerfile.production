# Multi-stage Dockerfile for Komga with PostgreSQL support
#
# Stage 1: Build frontend (Vue.js)
# Stage 2: Build backend (Gradle + JDK 21)
# Stage 3: Runtime (JRE 21)

# ============ Stage 1: Frontend ============
FROM node:18-alpine AS frontend-builder
WORKDIR /app/komga-webui
COPY komga-webui/package.json komga-webui/package-lock.json ./
RUN npm ci
COPY komga-webui/ ./
RUN npm run build

# ============ Stage 2: Backend ============
FROM gradle:8.14.3-jdk21-alpine AS backend-builder
WORKDIR /app
COPY . .
# Copy frontend build output to backend resources
COPY --from=frontend-builder /app/komga-webui/dist/ komga/src/main/resources/public/
# Build JAR
RUN gradle :komga:bootJar -x test --no-daemon

# ============ Stage 3: Runtime ============
FROM eclipse-temurin:21-jre-alpine AS runtime
WORKDIR /app
COPY --from=backend-builder /app/komga/build/libs/komga-*.jar app.jar
VOLUME /config
ENV KOMGA_CONFIGDIR=/config
EXPOSE 25600
ENTRYPOINT ["java", "-jar", "app.jar"]
